rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety net default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Campaign document access
    match /campaigns/{campaignId} {
      allow list, get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Global reusable helpers
    function isSignedIn() {
      return request.auth != null;
    }
  }
}
